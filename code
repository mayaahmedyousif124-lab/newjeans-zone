<script>


// Bunny visitor counter

let visits = localStorage.getItem("bunnyVisits");

if(!visits){
    visits = 1;
}else{
    visits++;
}

localStorage.setItem("bunnyVisits", visits);

document.getElementById("counter").innerHTML = visits;




// Save and display letters

let letters = JSON.parse(localStorage.getItem("bunnyLetters")) || [];


function showLetters(){

let wall = document.getElementById("letterWall");

wall.innerHTML="";


letters.forEach(function(letter){

let box=document.createElement("div");

box.className="letter";


box.innerHTML =
"🐰 <b>"+letter.name+"</b>"
+
"<br>"
+
"💙 To: "+letter.member
+
"<br><br>"
+
letter.text;


wall.appendChild(box);


});


}



function addLetter(){

let name=document.getElementById("nickname").value;

let member=document.getElementById("memberSelect").value;

let text=document.getElementById("message").value;


if(name==="" || text===""){

alert("Please complete your nickname and letter 🐰");

return;

}



let newLetter={

name:name,

member:member,

text:text

};



letters.unshift(newLetter);


localStorage.setItem(
"bunnyLetters",
JSON.stringify(letters)
);



showLetters();



document.getElementById("nickname").value="";

document.getElementById("message").value="";


alert("Your Bunny letter has been added! 💙");


}




// Search letters


function searchLetters(){

let input=document
.getElementById("search")
.value
.toLowerCase();


let allLetters=document
.querySelectorAll(".letter");



allLetters.forEach(function(letter){


if(letter.innerText
.toLowerCase()
.includes(input)){


letter.style.display="block";


}else{


letter.style.display="none";


}


});


}




// Dark mode


function darkMode(){

document.body.classList.toggle("dark");


let mode=document.body.classList.contains("dark");


localStorage.setItem(
"darkMode",
mode
);


}



// Keep dark mode after refresh


if(localStorage.getItem("darkMode")=="true"){

document.body.classList.add("dark");

}



// Load saved letters


showLetters();



</script>